{
  "name": "anime-quiz-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:shiki\" \"npm run dev:convex\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:shiki": "npm run dev --workspace=shiki-api",
    "dev:convex": "npm run dev --workspace=convex-backend",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=web",
    "build:shiki": "npm run build --workspace=shiki-api",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}